{
  "ci": {
    "collect": {
      "startServerCommand": "npx --yes serve@14.2.4 dist --listen 4173",
      "startServerReadyPattern": "Accepting connections",
      "url": ["http://localhost:4173/"],
      "numberOfRuns": 3,
      "settings": {
        "chromeFlags": "--no-sandbox --headless=new"
      }
    },
    "assert": {
      "assertions": {
        "largest-contentful-paint": ["error", { "maxNumericValue": 3500, "aggregationMethod": "median-run" }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.05, "aggregationMethod": "median-run" }],
        "total-blocking-time": ["error", { "maxNumericValue": 1000, "aggregationMethod": "median-run" }],
        "total-byte-weight": ["error", { "maxNumericValue": 500000, "aggregationMethod": "median-run" }],
        "categories:accessibility": ["error", { "minScore": 0.98, "aggregationMethod": "median-run" }],
        "categories:performance": ["warn", { "minScore": 0.7, "aggregationMethod": "median-run" }]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
